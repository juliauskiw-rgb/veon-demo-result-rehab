---
interface Props { href: string; }
const { href } = Astro.props;
---
<a class="logo" href={href}>
  <picture>
    <source srcset="/images/result-logo.webp" type="image/webp" />
    <img src="/images/result-logo.png" width="112" height="97" alt="Центр відновлення після інсульту Result" />
  </picture>
</a>
