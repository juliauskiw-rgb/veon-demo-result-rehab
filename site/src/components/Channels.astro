---
// The three real channels. Call is always the same filled button; messengers are outlined and weaker.
import { contacts } from "../data/site";
interface Props { only?: "call"; }
const { only } = Astro.props;
---
<div class="channels">
  <a class="btn btn--call" href={contacts.phoneHref}>Подзвонити {contacts.phoneText}</a>
  {!only && <a class="btn btn--line" href={contacts.telegram} target="_blank" rel="noopener noreferrer">Telegram</a>}
  {!only && <a class="btn btn--line" href={contacts.whatsapp} target="_blank" rel="noopener noreferrer">WhatsApp</a>}
</div>
