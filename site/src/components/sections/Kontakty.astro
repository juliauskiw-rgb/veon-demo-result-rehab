---
import Section from "../Section.astro";
import BlockHead from "../BlockHead.astro";
import { contacts } from "../../data/site";
---
<Section id="kontakty" class="kontakty">
  <div class="container">
    <BlockHead num="05" name="Контакти" title="Зв’язатися з центром" lead="Подзвоніть або напишіть у месенджер." />
    <div class="contact-cols">
      <div class="contact-col contact-col--phone">
        <h3>Телефон</h3>
        <a class="kontakty__phone" href={contacts.phoneHref}>{contacts.phoneText}</a>
        <a class="btn btn--call kontakty__call" href={contacts.phoneHref}>Подзвонити</a>
      </div>
      <div class="contact-col">
        <h3>Месенджери</h3>
        <div class="contact-col__btns">
          <a class="btn btn--line" href={contacts.telegram} target="_blank" rel="noopener noreferrer">Telegram</a>
          <a class="btn btn--line" href={contacts.whatsapp} target="_blank" rel="noopener noreferrer">WhatsApp</a>
        </div>
      </div>
      <div class="contact-col">
        <h3>Адреса і e-mail</h3>
        <p class="contact-col__facts">
          <a href={contacts.map} target="_blank" rel="noopener noreferrer">{contacts.addressShort}</a>
          <span>ЖК ParkLand</span>
          <a href={`mailto:${contacts.email}`}>{contacts.email}</a>
        </p>
      </div>
    </div>
  </div>
</Section>
