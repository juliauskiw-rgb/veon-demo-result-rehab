---
import Section from "../Section.astro";
import BlockHead from "../BlockHead.astro";
import { stages } from "../../data/site";
---
<Section id="shlyah" class="shlyah on-dark">
  <div class="container">
    <BlockHead num="03" name="Як проходить" title="Як проходить реабілітація" lead="Чотири етапи. Програму коригують за потреби." />
    <ol class="stages">
      {stages.map((s) => (
        <li class="stage">
          <h3>{s.title}</h3>
          <p>{s.text}</p>
        </li>
      ))}
    </ol>
    <p class="shlyah__note">Майте на увазі, що іноді мова йде не про повне одужання. При тяжких станах мета полягає в досягненні максимально можливого рівня самостійності.</p>
  </div>
</Section>
