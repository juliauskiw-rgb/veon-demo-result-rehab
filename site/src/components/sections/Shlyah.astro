---
import Section from "../Section.astro";
import { stages } from "../../data/site";
---
<Section id="shlyah" class="shlyah on-dark">
  <div class="container shlyah__grid">
    <h2>Як проходить реабілітація</h2>
    <ol class="stages">
      {stages.map((s, i) => (
        <li class="stage">
          <h3>{s.title}</h3>
          <p>{s.text}</p>
          {i === 1 && <span class="stage__head" aria-hidden="true"></span>}
          {i === 2 && <p class="stage__loop">Програму коригують за потреби</p>}
        </li>
      ))}
    </ol>
    <p class="shlyah__note">Майте на увазі, що іноді мова йде не про повне одужання. При тяжких станах мета полягає в досягненні максимально можливого рівня самостійності.</p>
  </div>
</Section>
