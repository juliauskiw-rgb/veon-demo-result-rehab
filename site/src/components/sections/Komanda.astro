---
import Section from "../Section.astro";
import BlockHead from "../BlockHead.astro";
import FutureLink from "../FutureLink.astro";
import { futureNote, team } from "../../data/site";
---
<Section id="komanda" class="komanda" rec="R-UX09">
  <div class="container">
    <BlockHead num="04" name="Команда" title="Хто працюватиме з вами" lead="Лікар ФРМ, старший фізичний терапевт і лікар-невролог." />
    <ul class="team">
      {team.map((m) => (
        <li class="person">
          <picture>
            <source srcset={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/images/${m.photo}.avif`} type="image/avif" />
            <source srcset={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/images/${m.photo}.webp`} type="image/webp" />
            <img src={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/images/${m.photo}.jpg`} width="292" height="365" loading="lazy" decoding="async" alt={`Портрет: ${m.name}`} />
          </picture>
          <div>
            <h3>{m.name}</h3>
            <p>{m.role}</p>
          </div>
        </li>
      ))}
    </ul>
    <p class="komanda__more"><FutureLink note={futureNote}>Вся команда</FutureLink></p>
  </div>
</Section>
