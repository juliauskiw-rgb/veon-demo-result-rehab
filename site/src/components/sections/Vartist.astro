---
import Section from "../Section.astro";
import BlockHead from "../BlockHead.astro";
import Channels from "../Channels.astro";
import DayStrip from "../DayStrip.astro";
import FutureLink from "../FutureLink.astro";
import { admissionFee, futureNote, included, outpatient, programmes, singleRoom } from "../../data/site";
---
<Section id="vartist" class="vartist" rec="R-UX02">
  <div class="container">
    <BlockHead num="02" name="Вартість" title="Що входить у добу і скільки коштує" lead="Заняття, кімната й харчування входять у ціну доби." />
    <div class="price-tabs" role="tablist" aria-label="Формат реабілітації">
      <button class="price-tab" type="button" role="tab" id="tab-inpatient" aria-selected="true" aria-controls="panel-inpatient">Стаціонар</button>
      <button class="price-tab" type="button" role="tab" id="tab-outpatient" aria-selected="false" aria-controls="panel-outpatient" tabindex="-1">Амбулаторно</button>
    </div>

    <div id="panel-inpatient" class="price-panel is-active" role="tabpanel" aria-labelledby="tab-inpatient">
      <div class="price-main">
      <div class="day-contents">
        <h3>У кожну добу входить</h3>
        <dl class="included">
          {included.map((x) => (
            <div>
              <dt>{x.term}</dt>
              <dd>{x.detail}</dd>
            </div>
          ))}
        </dl>
      </div>

      <table class="price-table">
        <caption class="visually-hidden">Вартість стаціонару: доба і програми на 7, 14 та 30 днів</caption>
        <tbody>
          {programmes.map((p, i) => (
            <tr class="price-row">
              <th scope="row">{p.label}</th>
              <td class="price-row__sum">{p.sum}</td>
              <td class="price-row__days"><DayStrip filled={p.days} animate index={i} /></td>
            </tr>
          ))}
        </tbody>
      </table>
      </div>

      <div class="price-extra">
      <div class="price-detail">
        <h3>Окремо, один раз при поступленні</h3>
        <p>Консультації невролога і лікаря ФРМ, по&nbsp;{admissionFee}. У стаціонарі вони оплачуються обов’язково, окремим платежем.</p>
      </div>

      <div class="single-room">
        <h3>Одномісне розміщення</h3>
        <ul>
          {singleRoom.map((r) => (
            <li>
              <span>{r.label}</span>
              <strong>{r.sum}</strong>
            </li>
          ))}
        </ul>
      </div>
      </div>
    </div>

    <div id="panel-outpatient" class="price-panel" role="tabpanel" aria-labelledby="tab-outpatient">
      <table class="price-list">
        <caption class="visually-hidden">Вартість амбулаторних занять і консультацій</caption>
        <tbody>
          {outpatient.map((r) => (
            <tr>
              <th scope="row">{r.label}</th>
              <td>{r.sum}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <div class="vartist__actions">
      <Channels only="call" />
      <FutureLink note={futureNote}>Повний прайс</FutureLink>
    </div>
  </div>
</Section>
